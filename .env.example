# ============================================
# PHASE 1: Core Services Configuration
# ============================================

# Docker Network
COMPOSE_PROJECT_NAME=aicouncil

# OpenWebUI Configuration
OPENWEBUI_PORT=8080
OPENWEBUI_HOST=0.0.0.0

# Ollama Configuration
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODELS=llama2,mistral

# LiteLLM Configuration
LITELLM_PORT=4000
LITELLM_LOG_LEVEL=info
LITELLM_MASTER_KEY=your-secure-key-here

# ============================================
# PHASE 2: Intelligence & Epistemics
# ============================================

# Venice API Configuration
VENICE_API_KEY=your-venice-api-key
VENICE_API_BASE=https://api.venice.ai/v1
VENICE_MODEL=llama-405b

# Council Service Configuration
COUNCIL_PORT=8000
COUNCIL_DEBUG=false
COUNCIL_DELIBERATION_TIMEOUT=30
COUNCIL_MIN_CONSENSUS=0.5
COUNCIL_FALLBACK_MODEL=ollama/llama2

# ============================================
# PHASE 3: Provenance & Ritual Orchestration
# ============================================

# AnythingLLM Configuration
ANYTHINGLLM_PORT=3001
ANYTHINGLLM_STORAGE_DIR=/data/anythingllm

# Flowise Configuration
FLOWISE_PORT=3000
FLOWISE_DATABASE_PATH=/data/flowise

# Arweave Configuration
ARWEAVE_ENDPOINT=https://arweave.net
ARWEAVE_WALLET_KEY=your-arweave-key.json
BUNDLR_NODE=http://node1.bundlr.network:8000
BUNDLR_CURRENCY=arweave
BUNDLR_PRIVATE_KEY=your-bundlr-key

# Sui Configuration
SUI_NETWORK=testnet
SUI_FAUCET_URL=https://faucet.testnet.sui.io/gas
SUI_PACKAGE_ID=your-sui-package-id
SUI_ADMIN_MNEMONIC=your-mnemonic-phrase

# ============================================
# PHASE 4: Production Hardening
# ============================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis Configuration (Rate Limiting)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting & Cost Tracking
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
COST_TRACKING_ENABLED=true
COST_LIMIT_USD=10.0

# Authentication
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=86400
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-secret
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-secret

# ============================================
# Guardrails & Safety
# ============================================

# Refusal System
REFUSAL_ENABLED=true
REFUSAL_STRICT_MODE=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
JAILBREAK_THRESHOLD=0.7

# Content Moderation
CONTENT_MODERATION_ENABLED=true
MODERATION_API=openai

# ============================================
# Monitoring & Observability
# ============================================

DEBUG=false
LOG_LEVEL=info
SENTRY_DSN=
APM_ENABLED=false
PROMETHEUS_PORT=9090

# ============================================
# Deployment & Infrastructure
# ============================================

# Docker Image Registry
REGISTRY=docker.io
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Akash Configuration
AKASH_NETWORK=testnet
AKASH_ACCOUNT_ADDRESS=
AKASH_ACCOUNT_KEYNAME=
AKASH_KEY_RING_BACKEND=os

# Database
DATABASE_URL=postgresql://user:password@db:5432/aicouncil
DATABASE_POOL_SIZE=20

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/data/storage
STORAGE_S3_BUCKET=aicouncil-prod
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# ============================================
# Development Only
# ============================================

COMPOSE_FILE=docker-compose.yml
NODE_ENV=development
PYTHON_ENV=development
